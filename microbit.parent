# Imports go at the top
from microbit import *
import radio
radio.on()
radio.config(group=3)

while True:
    if button_a.was_pressed():
        radio.send('hello')
    message = radio.receive()
    if message:
        print(message)
        for i in range(2):
            if message :
                display.scroll(message)
            else:
                print("autre mb ne rep pas")  